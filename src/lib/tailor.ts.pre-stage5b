import {
  TAILOR_BASE_URL,
  isTerminal,
  type FinalizeRejected,
  type FinalizeRequest,
  type HealthResponse,
  type MeasureResponse,
  type TailorEngine,
  type TailorFamily,
  type TailorFamilyList,
  type TailorJob,
  type TailorLimits,
  type TailorMeasurement,
  type TailorRequest,
  type TailorResult,
  type TailorSkillLine,
} from '@contract/types'
import type { TailorMode, TailorModel } from '@contract/types'
import { assertAllowedTailorUrl } from '@/lib/tailor-url'
import {
  saveDocument,
  updateDocument,
  type DocumentKind,
  type StoredDocument,
} from '@/lib/documents'

// ---------------------------------------------------------------------------
// Tailor client — talks to the Mapper service on 127.0.0.1:8765.
//
// House discipline, mirrored from the OpenAI judge: no service running = zero
// network noise and an honest message, never a broken button or a silent
// failure. Nothing here throws at import time and nothing runs on a timer.
//
// The service is OFF by default (settings.tailorEnabled). A run costs real
// money against the user's Anthropic key, so it is opt-in, token-gated, and
// always preceded by a preflight.
// ---------------------------------------------------------------------------

export const TAILOR_TOKEN_KEY = 'flashfiller_tailor_v1'

export interface TailorConfig {
  baseUrl: string
  token: string
  /**
   * Which pipeline drafts the résumé (Plan 17). v6 = two agents, one page,
   * role-family lenses, hard line limits — the default. v5 = the vault-backed
   * pipeline, kept as the fallback ("switch back if v6 misbehaves").
   */
  engine: TailorEngine
  /** v6 / v7: a fixed role-family lens (id / slug); '' = let the router choose. */
  domain: string
  /** v7: 'skills' (the master's text, re-packed skills) — 'full' arrives in Stage 5b. */
  mode: TailorMode
  /** Stage 5: the picker's model preset; null = the engine's default. */
  writerModel: TailorModel | null
  extractorModel: TailorModel | null
}

const DEFAULT_CONFIG: TailorConfig = {
  baseUrl: TAILOR_BASE_URL, token: '', engine: 'v6', domain: '', mode: 'skills', writerModel: null, extractorModel: null,
}

const ENGINES_OFFERED: readonly TailorEngine[] = ['v6', 'v7']   // v5 left the picker in Stage 5 (≈ $0.28 / run on Opus)

function asModel(value: unknown): TailorModel | null {
  return value === 'claude-sonnet-4-6' || value === 'claude-haiku-4-5' ? value : null
}

export async function getTailorConfig(): Promise<TailorConfig> {
  const raw = await chrome.storage.local.get(TAILOR_TOKEN_KEY)
  const stored = raw?.[TAILOR_TOKEN_KEY] as Partial<TailorConfig> | undefined
  return {
    baseUrl: stored?.baseUrl?.trim() || DEFAULT_CONFIG.baseUrl,
    token: stored?.token?.trim() || '',
    engine: ENGINES_OFFERED.includes(stored?.engine as TailorEngine) ? (stored?.engine as TailorEngine) : 'v6',
    domain: stored?.domain?.trim() || '',
    mode: stored?.mode === 'full' ? 'full' : 'skills',
    writerModel: asModel(stored?.writerModel),
    extractorModel: asModel(stored?.extractorModel),
  }
}

export async function setTailorConfig(patch: Partial<TailorConfig>): Promise<void> {
  // Validate BEFORE persisting. A rejected address should never reach storage,
  // or the next request would fail against a value the user thinks was accepted.
  if (patch.baseUrl !== undefined) assertAllowedTailorUrl(patch.baseUrl.trim())
  const current = await getTailorConfig()
  await chrome.storage.local.set({ [TAILOR_TOKEN_KEY]: { ...current, ...patch } })
}



async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
  const { baseUrl, token } = await getTailorConfig()
  assertAllowedTailorUrl(baseUrl)

  let response: Response
  try {
    response = await fetch(`${baseUrl}${path}`, {
      ...init,
      headers: {
        'Content-Type': 'application/json',
        ...(token ? { 'X-Tailor-Token': token } : {}),
        ...(init.headers ?? {}),
      },
    })
  } catch {
    // fetch() rejects for connection-refused — the ordinary "service isn't
    // running" case, not an error worth a stack trace.
    throw new TailorOfflineError()
  }

  if (response.status === 401) {
    throw new Error(
      'Tailor rejected the token. Set it with "Set token" above — it is printed when ' +
      '`make serve` starts and cached in apps/mapper/.tailor-token.',
    )
  }

  const text = await response.text()
  let payload: unknown = null
  if (text) {
    try {
      payload = JSON.parse(text)
    } catch {
      throw new Error(`Tailor returned a non-JSON response (HTTP ${response.status}).`)
    }
  }

  if (response.status === 422 && payload && typeof payload === 'object' && 'violations' in payload) {
    // v6 finalize refused: an edited box renders over its lines. Nothing was
    // written or trimmed — the page highlights the boxes and the user shortens.
    throw new FinalizeRejectedError(payload as FinalizeRejected)
  }

  if (!response.ok) {
    const message = (payload as { error?: string } | null)?.error
    throw new Error(message ?? `Tailor returned HTTP ${response.status}.`)
  }
  return payload as T
}

export class TailorOfflineError extends Error {
  constructor() {
    super('Tailor service is not running.')
    this.name = 'TailorOfflineError'
  }
}

/** HTTP 422 from /finalize (v6): the boxes that are over their rendered-line limit. */
export class FinalizeRejectedError extends Error {
  readonly violations: TailorMeasurement[]
  readonly limits: TailorLimits | null
  constructor(body: FinalizeRejected) {
    super(body.error || 'Some boxes are over their line limits.')
    this.name = 'FinalizeRejectedError'
    this.violations = body.violations ?? []
    this.limits = body.limits ?? null
  }
}

export async function checkHealth(): Promise<HealthResponse | null> {
  try {
    return await request<HealthResponse>('/health')
  } catch (error) {
    if (error instanceof TailorOfflineError) return null
    throw error
  }
}

export async function startTailor(req: TailorRequest): Promise<TailorJob> {
  return request<TailorJob>('/tailor', { method: 'POST', body: JSON.stringify(req) })
}

export async function getJob(jobId: string): Promise<TailorJob> {
  return request<TailorJob>(`/tailor/${encodeURIComponent(jobId)}`)
}

export async function cancelJob(jobId: string): Promise<boolean> {
  const res = await request<{ cancelled: boolean }>(
    `/tailor/${encodeURIComponent(jobId)}/cancel`,
    { method: 'POST' },
  )
  return res.cancelled
}

/**
 * Approve a draft run, with the user's edits, and get the rendered document
 * back. An empty edits object approves the draft exactly as generated. Only
 * fields present count as human-edited — the service clears their review
 * flags; untouched flagged pieces keep warning on the returned result.
 */
export async function finalizeJob(jobId: string, edits: FinalizeRequest = {}): Promise<TailorJob> {
  return request<TailorJob>(`/tailor/${encodeURIComponent(jobId)}/finalize`, {
    method: 'POST',
    body: JSON.stringify(edits),
  })
}

/**
 * v6: measure the review boxes as typed — rendered lines and characters per
 * box under the template's font metrics. No spend, no state change; the page
 * calls it debounced while the user edits, so the counters are the renderer's
 * truth rather than a character estimate.
 */
export async function measureEdits(jobId: string, edits: FinalizeRequest): Promise<MeasureResponse> {
  return request<MeasureResponse>(`/tailor/${encodeURIComponent(jobId)}/measure`, {
    method: 'POST',
    body: JSON.stringify(edits),
  })
}

/** v6: the 31 role families the router can choose (for the lens picker). */
export async function listFamilies(): Promise<TailorFamily[]> {
  const res = await request<TailorFamilyList>('/tailor/domains')
  return res.families ?? []
}

/** Open the generated .docx directly (view/download) without storing it. */
export function downloadResultDocument(result: TailorResult): void {
  if (!result.document) return
  const { name, mime, bytesB64 } = result.document
  const url = URL.createObjectURL(base64ToBlob(bytesB64, mime))
  const a = document.createElement('a')
  a.href = url
  a.download = name
  a.click()
  setTimeout(() => URL.revokeObjectURL(url), 30_000)
}

// ---------------------------------------------------------------------------
// Cover letter — on-demand, per finished run (v5 Phase 7).
//
// Same honesty discipline as the run itself: explicit button, cost named up
// front, job-id + poll (never a long blocking POST), and the letter is REVIEW
// MATERIAL — it is shown, copied, downloaded or saved to Documents on the
// user's click, never auto-attached to a page.
// ---------------------------------------------------------------------------

/** Rough pre-generation estimate — one Haiku analysis + a Sonnet letter. */
export function estimateCoverLetterCostUsd(): number {
  return 0.05
}

/** Ask the service to start letter generation for a DONE run. */
export async function requestCoverLetter(jobId: string): Promise<TailorJob> {
  return request<TailorJob>(`/tailor/${encodeURIComponent(jobId)}/coverletter`, {
    method: 'POST',
  })
}

/** Poll until coverLetterStatus leaves 'running'. Runs in the UI page. */
export async function pollCoverLetter(
  jobId: string,
  onUpdate: (job: TailorJob) => void,
  opts: { intervalMs?: number; timeoutMs?: number; signal?: AbortSignal } = {},
): Promise<TailorJob> {
  const interval = opts.intervalMs ?? 2000
  const timeout = opts.timeoutMs ?? 5 * 60 * 1000
  const startedAt = Date.now()

  for (; ;) {
    if (opts.signal?.aborted) throw new Error('Stopped watching the cover letter.')
    const job = await getJob(jobId)
    onUpdate(job)
    if ((job.result?.coverLetterStatus ?? 'none') !== 'running') return job
    if (Date.now() - startedAt > timeout) {
      throw new Error('Gave up waiting after 5 minutes — reopen to check on the letter.')
    }
    await new Promise((resolve) => setTimeout(resolve, interval))
  }
}

/** Open the generated letter .docx directly (view/download) without storing it. */
export function downloadCoverLetterDocument(result: TailorResult): void {
  if (!result.coverLetterDocument) return
  const { name, mime, bytesB64 } = result.coverLetterDocument
  const url = URL.createObjectURL(base64ToBlob(bytesB64, mime))
  const a = document.createElement('a')
  a.href = url
  a.download = name
  a.click()
  setTimeout(() => URL.revokeObjectURL(url), 30_000)
}

/**
 * Store the letter .docx in Documents as kind 'coverLetter'. From that point
 * it is a USER-STORED document and the existing document rules govern it —
 * pickDocument only ever offers it to cover-letter upload zones. saveDocument
 * auto-stars the first document of a kind; no forced re-star here.
 */
export async function saveCoverLetterAsDocument(result: TailorResult): Promise<StoredDocument> {
  if (!result.coverLetterDocument) {
    throw new Error('This run has no rendered cover letter document yet.')
  }
  const { name, mime, bytesB64 } = result.coverLetterDocument
  const file = new File([base64ToBlob(bytesB64, mime)], name, { type: mime })
  return saveDocument(file, 'coverLetter')
}

/**
 * Poll until the job reaches a terminal state.
 *
 * Runs in the UI page, not the service worker — a worker is torn down at ~30s
 * idle and this takes minutes. Closing the popup abandons the poll, not the
 * job: the service keeps running and the result is still there on reopen.
 */
export async function pollUntilDone(
  jobId: string,
  onUpdate: (job: TailorJob) => void,
  opts: { intervalMs?: number; timeoutMs?: number; signal?: AbortSignal } = {},
): Promise<TailorJob> {
  const interval = opts.intervalMs ?? 2500
  const timeout = opts.timeoutMs ?? 15 * 60 * 1000
  const startedAt = Date.now()

  for (; ;) {
    if (opts.signal?.aborted) throw new Error('Stopped watching this run.')
    const job = await getJob(jobId)
    onUpdate(job)
    if (isTerminal(job.status)) return job
    if (Date.now() - startedAt > timeout) {
      throw new Error('Gave up waiting after 15 minutes — the run may still be going; reopen to check.')
    }
    await new Promise((resolve) => setTimeout(resolve, interval))
  }
}

// ---------------------------------------------------------------------------
// Run continuity — the popup closing must never "destroy" a generation.
//
// Closing the popup only ever abandoned the POLL; the service keeps drafting.
// What was actually lost was the tab's memory of WHICH job was running and
// what the reviewer had typed. Both now live in chrome.storage.local, so on
// reopen the tab re-adopts the run exactly where it left off: still running →
// polling resumes; finished while closed → the draft (plus any typed edits)
// comes straight back; the service was restarted → the record is dropped
// honestly.
//
// These are continuity aids, not the run itself: a storage hiccup must never
// take down a paid run, so every helper swallows its own failures.
// ---------------------------------------------------------------------------

export const TAILOR_ACTIVE_RUN_KEY = 'flashfiller_tailor_active_run_v1'
export const TAILOR_DRAFT_EDITS_KEY = 'flashfiller_tailor_draft_edits_v1'

/** The one real (non-dry) run the tab last started. Replaced on every start. */
export interface ActiveRunRecord {
  jobId: string
  role: string
  company: string | null
  /** Kept so reopening restores the JD box (re-draft needs it too). */
  jdText: string
  engine: TailorEngine
  domain: string
  startedAt: number
}

/** What the reviewer had typed into the boxes, keyed to its job. */
export interface StoredDraftEdits {
  jobId: string
  summary: string
  skills: TailorSkillLine[]
  bullets: Record<number, string>
  hidden: string | null
  savedAt: number
}

export async function saveActiveRun(rec: ActiveRunRecord): Promise<void> {
  try {
    await chrome.storage.local.set({ [TAILOR_ACTIVE_RUN_KEY]: rec })
  } catch { /* continuity only — never fail the run over storage */ }
}

export async function getActiveRun(): Promise<ActiveRunRecord | null> {
  try {
    const raw = await chrome.storage.local.get(TAILOR_ACTIVE_RUN_KEY)
    const rec = raw?.[TAILOR_ACTIVE_RUN_KEY] as ActiveRunRecord | undefined
    return rec && typeof rec.jobId === 'string' && rec.jobId ? rec : null
  } catch {
    return null
  }
}

export async function clearActiveRun(): Promise<void> {
  try {
    await chrome.storage.local.remove(TAILOR_ACTIVE_RUN_KEY)
  } catch { /* see above */ }
}

export async function saveDraftEdits(edits: StoredDraftEdits): Promise<void> {
  try {
    await chrome.storage.local.set({ [TAILOR_DRAFT_EDITS_KEY]: edits })
  } catch { /* see above */ }
}

/** The stored edits, but only if they belong to this job — stale edits from an
 *  earlier run must never leak into another draft's boxes. */
export async function getDraftEdits(jobId: string): Promise<StoredDraftEdits | null> {
  try {
    const raw = await chrome.storage.local.get(TAILOR_DRAFT_EDITS_KEY)
    const rec = raw?.[TAILOR_DRAFT_EDITS_KEY] as StoredDraftEdits | undefined
    return rec && rec.jobId === jobId ? rec : null
  } catch {
    return null
  }
}

export async function clearDraftEdits(): Promise<void> {
  try {
    await chrome.storage.local.remove(TAILOR_DRAFT_EDITS_KEY)
  } catch { /* see above */ }
}

/** True when this error means the service no longer knows the job (it was
 *  restarted — the registry is in memory). A wrong token or offline service is
 *  NOT that: the record must survive those. */
export function isUnknownJobError(e: unknown): boolean {
  return e instanceof Error && !(e instanceof TailorOfflineError) && /unknown job/i.test(e.message)
}

function base64ToBlob(b64: string, mime: string): Blob {
  const binary = atob(b64)
  const bytes = new Uint8Array(binary.length)
  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i)
  return new Blob([bytes], { type: mime })
}

/**
 * Hand the generated document to the existing document store. From here the
 * resume is indistinguishable from one the user uploaded by hand: pickDocument
 * matches it, fillFileUpload attaches it, validate verifies it.
 *
 * `makeDefault` matters more than it looks. saveDocument only auto-stars the
 * FIRST document of a kind, so on any machine that already has a resume stored
 * the freshly tailored one would be saved but NOT be the one pickDocument
 * attaches — the whole run would silently have no effect on the next
 * application. A résumé generated for a specific posting is precisely the one
 * that should go out, so it takes the star by default.
 */
export async function saveResultAsDocument(
  result: TailorResult,
  { kind = 'resume' as DocumentKind, makeDefault = true } = {},
): Promise<StoredDocument> {
  if (!result.document) throw new Error('That run produced bullets but no document.')
  const { name, mime, bytesB64 } = result.document
  const file = new File([base64ToBlob(bytesB64, mime)], name, { type: mime })
  const saved = await saveDocument(file, kind)
  if (makeDefault && !saved.isDefault) await updateDocument(saved.id, { isDefault: true })
  return saved
}

/** Rough pre-run estimate. Real spend comes back on the job as costUsd. */
export function estimateCostUsd(engine: TailorEngine = 'v6', preset: TailorPreset = {}): number {
  // The same table as the /batch page's EST_USD_BY_ENGINE (service/batch.py) — change both together.
  // v6: Sonnet extractor (~$0.07) + Sonnet writer (~$0.13) + tighten rounds; the Haiku extractor
  // saves ~$0.07, all-Haiku lands near $0.09. v7 skills: one Haiku extraction, the master's text.
  // v5: the Haiku-tiered vault pipeline (first clean run ~$0.15) — no longer in the picker.
  if (engine === 'v7') return preset.extractorModel === 'claude-sonnet-4-6' ? 0.09 : 0.03
  if (engine === 'v5') return 0.15
  const haikuWriter = preset.writerModel === 'claude-haiku-4-5'
  const haikuExtractor = preset.extractorModel === 'claude-haiku-4-5'
  if (haikuWriter && haikuExtractor) return 0.09
  if (haikuWriter) return 0.16
  if (haikuExtractor) return 0.15
  return 0.22
}

/** v6: re-drafting the same posting under another lens reuses the extraction — writer only. */
export function estimateRedraftCostUsd(preset: TailorPreset = {}): number {
  return preset.writerModel === 'claude-haiku-4-5' ? 0.05 : 0.14
}

/** The picker's model presets (Stage 5). null = the engine's default. */
export interface TailorPreset {
  writerModel?: TailorModel | null
  extractorModel?: TailorModel | null
}

export const V6_PRESETS: { id: string; label: string; preset: TailorPreset }[] = [
  { id: 'sonnet', label: 'Sonnet extractor + writer (default)', preset: {} },
  { id: 'haiku-extractor', label: 'Haiku extractor, Sonnet writer', preset: { extractorModel: 'claude-haiku-4-5' } },
  { id: 'haiku', label: 'all Haiku', preset: { writerModel: 'claude-haiku-4-5', extractorModel: 'claude-haiku-4-5' } },
]

export const V7_PRESETS: { id: string; label: string; preset: TailorPreset }[] = [
  { id: 'haiku-extractor', label: 'Haiku extractor (default)', preset: {} },
  { id: 'sonnet-extractor', label: 'Sonnet extractor', preset: { extractorModel: 'claude-sonnet-4-6' } },
]

export function presetId(engine: TailorEngine, preset: TailorPreset): string {
  const list = engine === 'v7' ? V7_PRESETS : V6_PRESETS
  const hit = list.find((p) => (p.preset.writerModel ?? null) === (preset.writerModel ?? null)
    && (p.preset.extractorModel ?? null) === (preset.extractorModel ?? null))
  return hit?.id ?? list[0].id
}